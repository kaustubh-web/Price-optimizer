generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id              String         @id @default(uuid())
  wooCommerceId   Int            @unique
  name            String
  slug            String?
  sku             String?
  status          String         @default("publish")
  description     String?
  categories      String[]
  regularPrice    Float
  salePrice       Float?
  currentPrice    Float
  stockStatus     String         @default("instock")
  stockQuantity   Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  priceHistory    PriceHistory[]
  orderItems      OrderItem[]
  recommendations Recommendation[]

  @@map("products")
}

model PriceHistory {
  id              String    @id @default(uuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  regularPrice    Float
  salePrice       Float?
  effectivePrice  Float
  changedAt       DateTime  @default(now())
  source          String    @default("sync") // "sync", "manual", "ai_applied"

  @@index([productId, changedAt])
  @@map("price_history")
}

model Order {
  id              String      @id @default(uuid())
  wooCommerceId   Int         @unique
  status          String
  currency        String      @default("INR")
  totalAmount     Float
  customerCity    String?
  customerState   String?
  orderDate       DateTime
  createdAt       DateTime    @default(now())

  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id                   String   @id @default(uuid())
  orderId              String
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  wooCommerceProductId Int
  quantity             Int
  priceAtPurchase      Float
  total                Float

  @@map("order_items")
}

model Recommendation {
  id                     String   @id @default(uuid())
  productId              String
  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  currentPrice           Float
  recommendedPrice       Float
  predictedDemandChange  Float   
  predictedRevenueChange Float    
  elasticityScore        Float   
  rationale              String   // Explanation generated by LLM (Claude/Gemini)
  status                 String   @default("PENDING") // PENDING, APPLIED, REJECTED
  createdAt              DateTime @default(now())

  @@map("recommendations")
}
